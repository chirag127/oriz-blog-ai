---
/*
 * CellIndexRail — left notebook cell-index rail (NOTEBOOK / TWO-PANE archetype).
 *
 * The persistent left pane of the notebook: a numbered execution index of the
 * most-recent posts (In[n]) whose ordering encodes real recency, then the
 * notebook's section nav (series / categories / tags / about) written as
 * kernel namespaces. Mobile: reuses the shared #sb-toggle drawer mechanism
 * (focus-trap + reduced-motion already handled by Sidebar's script), so this
 * rail is just the drawer's content on small screens.
 */
import {
  getCategoriesWithCounts,
  getPublishedPosts,
  postVertical,
  slugifyTag,
} from '~/lib/blog'

const all = await getPublishedPosts()
const total = all.length
// Newest post = highest execution index (In[N]); ordering is real recency.
const cells = all.slice(0, 9).map((p, i) => ({
  n: total - i,
  active: i === 0,
  id: p.id,
  title: p.data.title,
  vertical: postVertical(p),
}))

const namespaces = (await getCategoriesWithCounts()).slice(0, 6).map((c) => ({
  label: c.category,
  count: c.count,
  href: `/categories/${slugifyTag(c.category)}/`,
}))

const sections = [
  { label: 'series', href: '/series/', glyph: '⟳' },
  { label: 'tags', href: '/tags/', glyph: '#' },
  { label: 'archive', href: '/archive/', glyph: '⌗' },
  { label: 'about', href: '/about/', glyph: 'ƒ' },
]
---
<div class="rail">
  <section class="rail-block" aria-labelledby="rail-cells">
    <h2 id="rail-cells" class="rail-h">
      <span class="rail-h-glyph" aria-hidden="true">In[ ]</span>cells
    </h2>
    <ol class="cell-index" role="list">
      {cells.map((c) => (
        <li class="ci-row" data-vertical={c.vertical}>
          <a class="ci-link" href={`/blog/${c.id}`} aria-current={c.active ? 'true' : undefined}>
            <span class="ci-prompt mono" aria-hidden="true">In[<span class="ci-n">{c.n}</span>]</span>
            <span class="ci-title">{c.title}</span>
          </a>
        </li>
      ))}
    </ol>
    <a class="ci-all mono" href="/archive/">all {total} cells →</a>
  </section>

  {namespaces.length > 0 && (
    <section class="rail-block" aria-labelledby="rail-ns">
      <h2 id="rail-ns" class="rail-h"><span class="rail-h-glyph" aria-hidden="true">::</span>namespaces</h2>
      <ul class="rail-list" role="list">
        {namespaces.map((ns) => (
          <li>
            <a class="rail-item mono" href={ns.href}>
              <span class="ri-label">{ns.label}</span>
              <span class="ri-count">{ns.count}</span>
            </a>
          </li>
        ))}
      </ul>
    </section>
  )}

  <section class="rail-block" aria-labelledby="rail-nav">
    <h2 id="rail-nav" class="rail-h"><span class="rail-h-glyph" aria-hidden="true">⇥</span>navigate</h2>
    <ul class="rail-list" role="list">
      {sections.map((s) => (
        <li>
          <a class="rail-item mono" href={s.href}>
            <span class="ri-glyph" aria-hidden="true">{s.glyph}</span>
            <span class="ri-label">{s.label}</span>
          </a>
        </li>
      ))}
    </ul>
  </section>
</div>

<style>
  .rail {
    display: flex;
    flex-direction: column;
    gap: 1.75rem;
    font-family: var(--font-mono);
  }
  .rail-block { display: flex; flex-direction: column; gap: 0.5rem; }
  .rail-h {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    margin: 0 0 0.375rem;
    font-family: var(--font-mono);
    font-size: 10px;
    font-weight: 500;
    letter-spacing: 0.2em;
    text-transform: uppercase;
    color: var(--ink-mute);
  }
  .rail-h-glyph { color: var(--accent); letter-spacing: 0; }

  /* ── cell index — the notebook's execution list ─────────────────────── */
  .cell-index { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; }
  .ci-row { --v: var(--v-personal); }
  .ci-row[data-vertical='dev'] { --v: var(--v-dev); }
  .ci-row[data-vertical='finance'] { --v: var(--v-finance); }
  .ci-row[data-vertical='culture'] { --v: var(--v-culture); }
  .ci-row[data-vertical='health'] { --v: var(--v-health); }
  .ci-link {
    display: grid;
    grid-template-columns: 3.75em 1fr;
    align-items: baseline;
    column-gap: 0.5rem;
    padding: 0.3125rem 0.375rem 0.3125rem 0.5rem;
    border-left: 2px solid transparent;
    color: var(--ink);
    text-decoration: none;
    transition: border-color var(--dur-fast) ease, background var(--dur-fast) ease;
  }
  .ci-prompt {
    font-size: 11px;
    color: var(--ink-mute);
    letter-spacing: -0.02em;
    text-align: right;
    white-space: nowrap;
  }
  .ci-n { color: var(--accent); }
  .ci-title {
    font-family: var(--font-display);
    font-size: 13.5px;
    font-weight: 500;
    line-height: 1.3;
    letter-spacing: -0.01em;
    color: var(--ink);
    display: -webkit-box;
    -webkit-box-orient: vertical;
    -webkit-line-clamp: 2;
    line-clamp: 2;
    overflow: hidden;
  }
  .ci-link:hover { border-left-color: var(--v); background: color-mix(in oklab, var(--v) 6%, transparent); }
  .ci-link:hover .ci-title { color: var(--accent); }
  .ci-link[aria-current='true'] {
    border-left-color: var(--hot);
    background: color-mix(in oklab, var(--hot) 8%, transparent);
  }
  .ci-link[aria-current='true'] .ci-prompt { color: var(--hot); }
  .ci-link[aria-current='true'] .ci-n { color: var(--hot); }
  .ci-all {
    margin-top: 0.5rem;
    font-size: 11px;
    letter-spacing: 0.02em;
    color: var(--ink-mute);
    text-decoration: none;
  }
  .ci-all:hover { color: var(--accent); }

  /* ── generic rail lists ─────────────────────────────────────────────── */
  .rail-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 1px; }
  .rail-item {
    display: flex;
    align-items: baseline;
    gap: 0.5rem;
    padding: 0.3125rem 0.5rem;
    font-size: 12px;
    letter-spacing: 0.02em;
    color: var(--ink);
    text-decoration: none;
    border-left: 2px solid transparent;
    transition: border-color var(--dur-fast) ease, color var(--dur-fast) ease;
  }
  .rail-item:hover { border-left-color: var(--accent); color: var(--accent); }
  .ri-glyph { color: var(--ink-mute); width: 1em; text-align: center; }
  .rail-item:hover .ri-glyph { color: var(--accent); }
  .ri-label { flex: 1 1 auto; }
  .ri-count { color: var(--ink-mute); font-size: 11px; font-variant-numeric: tabular-nums; }
</style>
