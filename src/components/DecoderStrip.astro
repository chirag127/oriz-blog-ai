---
/**
 * DecoderStrip — bespoke AI-blog signature component.
 *
 * Renders the last word of a heading as the argmax token over a set of
 * candidate tokens, each with a faint probability bar behind it. The
 * winning token (argmax) is highlighted in hot-weight (burnt-orange).
 *
 * Used as a visual signature below the hero headline to communicate
 * "we think in token probabilities" — belongs only to the AI/ML niche.
 *
 * Props:
 *   candidates — array of { token: string, prob: number 0-1 }
 *   label      — optional label text (default "decoder · argmax")
 *   aria-label — accessible description
 */
export interface TokenCandidate {
  token: string
  prob: number
}

interface Props {
  candidates: TokenCandidate[]
  label?: string
  'aria-label'?: string
}

const {
  candidates,
  label = 'decoder · argmax',
  'aria-label': ariaLabel,
} = Astro.props

// Sort descending so argmax is first
const sorted = [...candidates].sort((a, b) => b.prob - a.prob)
const argmax = sorted[0]
---

<figure
  class="decoder-strip"
  role="img"
  aria-label={ariaLabel ?? `Token probability distribution. Argmax: ${argmax.token} at ${Math.round(argmax.prob * 100)}%`}
>
  <figcaption class="ds-label mono" aria-hidden="true">{label}</figcaption>
  <ol class="ds-tokens" role="presentation">
    {sorted.map((t) => (
      <li class:list={['ds-token', { 'ds-token--hot': t === argmax }]}>
        <span class="ds-bar" style={`--p: ${t.prob}`} aria-hidden="true"></span>
        <span class="ds-name mono">{t.token}</span>
        <span class="ds-prob mono" aria-hidden="true">{(t.prob * 100).toFixed(0)}%</span>
      </li>
    ))}
  </ol>
</figure>

<style>
  .decoder-strip {
    display: flex;
    flex-direction: column;
    gap: 0.375rem;
    margin: 0;
    padding: 0;
  }

  .ds-label {
    font-size: 10px;
    letter-spacing: 0.18em;
    text-transform: uppercase;
    color: var(--ink-mute);
    margin: 0 0 0.125rem;
  }

  .ds-tokens {
    list-style: none;
    margin: 0;
    padding: 0;
    display: flex;
    flex-direction: column;
    gap: 3px;
  }

  .ds-token {
    display: grid;
    grid-template-columns: 1fr auto auto;
    align-items: center;
    gap: 0.375rem;
    position: relative;
    padding: 2px 0.375rem;
  }

  /* probability bar behind the token row */
  .ds-bar {
    position: absolute;
    inset: 0 0 0 0;
    width: calc(var(--p) * 100%);
    background: color-mix(in oklab, var(--accent) 10%, transparent);
    pointer-events: none;
    z-index: 0;
  }
  .ds-token--hot .ds-bar {
    background: color-mix(in oklab, var(--hot) 14%, transparent);
  }

  .ds-name {
    position: relative;
    z-index: 1;
    font-size: 13px;
    letter-spacing: -0.01em;
    color: var(--ink);
    font-weight: 500;
  }
  .ds-token--hot .ds-name {
    color: var(--hot);
    font-weight: 600;
  }

  .ds-prob {
    position: relative;
    z-index: 1;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
    font-variant-numeric: tabular-nums;
  }
  .ds-token--hot .ds-prob {
    color: var(--hot);
  }

  @media (prefers-reduced-motion: no-preference) {
    .ds-bar {
      transform-origin: left;
      animation: ds-fill var(--dur-slow, 360ms) var(--ease-out, cubic-bezier(0.16,1,0.3,1)) both;
    }
    @keyframes ds-fill {
      from { transform: scaleX(0); }
      to   { transform: scaleX(1); }
    }
  }
</style>
