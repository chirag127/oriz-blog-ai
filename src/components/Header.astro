---
import HeaderControls from '~/components/HeaderControls.tsx'
import MultiSearch from '~/components/MultiSearch.tsx'
import StatusBanner from '~/components/StatusBanner.astro'
/*
 * Header — minimal notebook KERNEL BAR (NOTEBOOK / TWO-PANE archetype).
 *
 *   ┌────────────────────────────────────────────────────────────────┐
 *   │ latent[·]   kernel · ready ●   N cells        ⌘K   controls    │
 *   └────────────────────────────────────────────────────────────────┘
 *
 * Deliberately NOT a top-nav card-grid masthead: no LATEST/SERIES/TAGS/ABOUT
 * link row (nav lives in the left cell-index rail). The bar reads as a live
 * Jupyter kernel status strip — mono, a pulsing "ready" dot, a running cell
 * counter. Primary navigation is the rail, not this bar.
 */
import Wordmark from '~/components/Wordmark.astro'
import { getPublishedPosts } from '~/lib/blog'

const cellCount = (await getPublishedPosts()).length
---

<StatusBanner />
<header class="kernel-bar" transition:persist="site-header">
  <div class="kb-inner">
    <button
      type="button"
      class="kb-cells-toggle mono"
      data-sidebar-toggle
      aria-controls="site-sidebar"
      aria-expanded="false"
      aria-label="Open cell index"
    >
      <span class="kb-cells-glyph" aria-hidden="true">⌗</span>
      <span class="kb-cells-label">cells</span>
    </button>
    <div class="kb-brand">
      <Wordmark size={20} href="/" />
    </div>
    <p class="kb-kernel mono" aria-label={`Kernel ready — ${cellCount} cells executed`}>
      <span class="kb-kernel-key">kernel</span>
      <span class="kb-kernel-sep" aria-hidden="true">·</span>
      <span class="kb-kernel-state">ready<span class="kb-dot" aria-hidden="true"></span></span>
      <span class="kb-kernel-sep" aria-hidden="true">·</span>
      <span class="kb-kernel-count"><span class="kb-n">{cellCount}</span> cells</span>
    </p>
    <div class="kb-search">
      <MultiSearch client:idle />
    </div>
    <div class="kb-controls">
      <HeaderControls client:idle />
    </div>
  </div>
</header>

<style>
  .kernel-bar {
    position: sticky;
    top: 0;
    z-index: 50;
    background: color-mix(in oklab, var(--paper) 92%, transparent);
    backdrop-filter: saturate(180%) blur(10px);
    -webkit-backdrop-filter: saturate(180%) blur(10px);
    border-bottom: 1px solid var(--rule-strong, var(--rule));
  }
  .kb-inner {
    height: 52px;
    max-width: var(--container-page, 1100px);
    margin-inline: auto;
    padding-inline: clamp(0.75rem, 3vw, 1.5rem);
    display: flex;
    align-items: center;
    gap: 0.875rem;
  }
  .kb-cells-toggle {
    display: none;
    align-items: center;
    gap: 0.375rem;
    padding: 0.25rem 0.5rem;
    background: transparent;
    border: 1px solid var(--rule);
    color: var(--ink-mute);
    font-size: 11px;
    letter-spacing: 0.08em;
    text-transform: uppercase;
    cursor: pointer;
    border-radius: var(--radius-button);
  }
  .kb-cells-toggle:hover { color: var(--accent); border-color: var(--accent); }
  .kb-cells-glyph { color: var(--accent); }
  .kb-brand { flex: 0 0 auto; display: inline-flex; align-items: center; }

  .kb-kernel {
    display: none;
    align-items: baseline;
    gap: 0.4375rem;
    font-size: 11px;
    letter-spacing: 0.04em;
    color: var(--ink-mute);
    white-space: nowrap;
  }
  .kb-kernel-key { text-transform: uppercase; letter-spacing: 0.14em; }
  .kb-kernel-sep { color: var(--rule-strong, var(--rule)); }
  .kb-kernel-state { color: var(--ink); display: inline-flex; align-items: baseline; gap: 0.3125rem; }
  .kb-dot {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--accent);
    align-self: center;
    box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 60%, transparent);
    animation: kb-pulse 2.4s var(--ease-out) infinite;
  }
  .kb-n { color: var(--accent); font-variant-numeric: tabular-nums; }

  @keyframes kb-pulse {
    0% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 55%, transparent); }
    70% { box-shadow: 0 0 0 5px color-mix(in oklab, var(--accent) 0%, transparent); }
    100% { box-shadow: 0 0 0 0 color-mix(in oklab, var(--accent) 0%, transparent); }
  }
  @media (prefers-reduced-motion: reduce) {
    .kb-dot { animation: none; }
  }

  .kb-search { margin-left: auto; display: inline-flex; align-items: center; }
  .kb-controls { display: inline-flex; align-items: center; }
  .kb-search + .kb-controls { margin-left: 0.625rem; }

  @media (min-width: 768px) {
    .kb-kernel { display: inline-flex; margin-left: 0.75rem; }
  }
  @media (max-width: 767px) {
    .kb-cells-toggle { display: inline-flex; }
  }
</style>
