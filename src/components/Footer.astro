---
/*
 * Footer — notebook KERNEL SHUTDOWN strip (NOTEBOOK / TWO-PANE archetype).
 *
 * Not a 4-column magazine footer. Reads as the terminal output at the end of a
 * notebook run: a mono "[kernel] shutdown" line, then compact mono link groups
 * laid out like a dumped namespace (categories / tags / series), closed by the
 * shared LegalFooter. Signature voice = the shutdown prompt in signal-orange.
 */
import LegalFooter from '~/components/chrome/legal/LegalFooter.astro'
import {
  getCategoriesWithCounts,
  getTagsWithCounts,
  slugifyTag,
} from '~/lib/blog'

const categories = (await getCategoriesWithCounts()).slice(0, 6).map(({ category }) => ({
  name: category,
  slug: slugifyTag(category),
}))
const tags = (await getTagsWithCounts()).slice(0, 8).map(({ tag }) => tag)
---
<footer class="nb-footer" role="contentinfo">
  <div class="nbf-inner">
    <p class="nbf-shutdown mono">
      <span class="nbf-prompt" aria-hidden="true">[kernel]</span>
      <span class="nbf-msg">run complete — ship it, then log what broke.</span>
      <span class="nbf-cursor" aria-hidden="true"></span>
    </p>
    <div class="nbf-ns">
      <div class="nbf-col">
        <span class="nbf-key mono">categories/</span>
        <ul class="nbf-list">
          <li><a href="/categories/">all</a></li>
          {categories.map((c) => <li><a href={`/categories/${c.slug}/`}>{c.name}</a></li>)}
        </ul>
      </div>
      <div class="nbf-col">
        <span class="nbf-key mono">tags/</span>
        <ul class="nbf-list nbf-list--tags">
          {tags.map((t) => <li><a href={`/tags/${slugifyTag(t)}/`}>#{t}</a></li>)}
        </ul>
      </div>
      <div class="nbf-col">
        <span class="nbf-key mono">nav/</span>
        <ul class="nbf-list">
          <li><a href="/series/">series</a></li>
          <li><a href="/archive/">archive</a></li>
          <li><a href="/now/">now</a></li>
          <li><a href="/about/">about</a></li>
        </ul>
      </div>
    </div>
  </div>
  <LegalFooter
    github="https://github.com/chirag127/oriz-blog-ai"
    appName="latent"
    bio="A working log on building AI systems that survive production — RAG, agents, and honest evals — by Chirag Singhal."
    rss="/rss.xml"
  />
</footer>
<style>
  .nb-footer {
    margin-top: 5rem;
    background: var(--color-paper-2, var(--paper-2, transparent));
    color: var(--color-ink, var(--ink));
    border-top: 2px solid var(--ink);
  }
  .nbf-inner { max-width: var(--container-page, 1100px); margin: 0 auto; padding: 40px 24px 24px; }
  .nbf-shutdown {
    display: flex; flex-wrap: wrap; align-items: center; gap: 0.5rem;
    font-size: 13px; letter-spacing: 0.01em; color: var(--ink);
    margin: 0 0 32px;
    padding-bottom: 20px; border-bottom: 1px solid var(--rule);
  }
  .nbf-prompt { color: var(--hot); font-weight: 600; }
  .nbf-msg { color: var(--ink-mute); }
  .nbf-cursor {
    width: 8px; height: 15px; background: var(--accent); display: inline-block;
    animation: nbf-blink 1.1s steps(1) infinite;
  }
  @keyframes nbf-blink { 50% { opacity: 0; } }
  @media (prefers-reduced-motion: reduce) { .nbf-cursor { animation: none; } }

  .nbf-ns { display: grid; grid-template-columns: 1fr; gap: 24px; }
  .nbf-col { display: flex; flex-direction: column; gap: 12px; }
  .nbf-key {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.16em;
    color: var(--ink-mute); font-weight: 500;
  }
  .nbf-list { list-style: none; padding: 0; margin: 0; display: flex; flex-direction: column; gap: 6px; }
  .nbf-list a { color: var(--ink); font-family: var(--font-mono); font-size: 13px; text-decoration: none; }
  .nbf-list a:hover { color: var(--accent); }
  .nbf-list--tags { flex-direction: row; flex-wrap: wrap; gap: 8px 14px; }
  .nbf-list--tags a { color: var(--ink-mute); }
  .nbf-list--tags a:hover { color: var(--accent); }
  @media (min-width: 640px) { .nbf-ns { grid-template-columns: 1fr 1fr; gap: 32px; } }
  @media (min-width: 1024px) { .nbf-ns { grid-template-columns: 1.1fr 1.4fr 0.8fr; } }
</style>
