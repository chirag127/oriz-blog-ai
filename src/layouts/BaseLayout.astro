---
/*
 * BaseLayout — single page shell for every oriz-blog route (v2).
 *
 * Per-app divergent Header (sweep #5 revert). Footer + Sidebar wrapper +
 * BottomBar structure come from @chirag127/astro-chrome; sidebar slot and
 * bottombar actions are app-specific.
 */
import '~/styles/global.css'
import '~/styles/oriz-ui-overrides.css'
import 'katex/dist/katex.min.css'
import '~/styles/tokens.css'
import { ClientRouter } from 'astro:transitions'
import CellIndexRail from '~/components/CellIndexRail.astro'
import BottomBar from '~/components/chrome/BottomBar.astro'
import ConsentBanner from '~/components/chrome/ConsentBanner.astro'
import FamilyChrome from '~/components/chrome/FamilyChrome.astro'
import Sidebar from '~/components/chrome/Sidebar.astro'
import FeedDiscovery from '~/components/FeedDiscovery.astro'
import Footer from '~/components/Footer.astro'
import Header from '~/components/Header.astro'
import { bottomBarActions } from '~/data/bottombar-actions'

interface Props {
  title?: string
  description?: string
  canonical?: string
  noindex?: boolean
  jsonLd?: Record<string, unknown> | Record<string, unknown>[]
  image?: string
  type?: 'website' | 'article'
  pubDate?: Date
  updatedDate?: Date
  hideSidebar?: boolean
}

const {
  title = 'latent — AI systems, logged',
  description = 'A working log on building AI systems that survive production — RAG, tool-using agents, and honest evals. By Chirag Singhal.',
  canonical = `https://ai-blog.oriz.in${Astro.url.pathname}`,
  noindex = false,
  jsonLd,
  image,
  type = 'website',
  pubDate,
  updatedDate,
  hideSidebar = false,
} = Astro.props

const adsenseClient = import.meta.env.PUBLIC_ADSENSE_CLIENT
const beaconToken = import.meta.env.PUBLIC_CF_BEACON_TOKEN
const ga4Id = import.meta.env.PUBLIC_GA4_ID
const ogImage = image ? new URL(image, 'https://ai-blog.oriz.in').toString() : undefined
const visibleBottomBarActions = hideSidebar
  ? bottomBarActions.filter((action) => action.label !== 'Menu')
  : bottomBarActions
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>{title}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />
    {noindex && <meta name="robots" content="noindex" />}
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:url" content={canonical} />
    <meta property="og:type" content={type} />
    <meta property="og:site_name" content="latent" />
    {ogImage && <meta property="og:image" content={ogImage} />}
    {type === 'article' && pubDate && (
      <meta property="article:published_time" content={pubDate.toISOString()} />
    )}
    {type === 'article' && updatedDate && (
      <meta property="article:modified_time" content={updatedDate.toISOString()} />
    )}
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:site" content="@chirag127" />

    <!-- Apply the saved reading theme before paint so the editorial surface never flashes. -->
    <script is:inline>
      {`(() => {
        try {
          const theme = localStorage.getItem('oriz:theme')
          if (theme && theme !== 'auto' && ['light', 'dark', 'hc'].includes(theme)) {
            document.documentElement.dataset.theme = theme
          }
        } catch (_) {}
      })()`}
    </script>

    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="manifest" href="/manifest.webmanifest" />
    <meta name="theme-color" content="#f4f7f4" media="(prefers-color-scheme: light)" />
    <meta name="theme-color" content="#0d1117" media="(prefers-color-scheme: dark)" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <FeedDiscovery />

    <ClientRouter />

    {jsonLd && (
      <script
        is:inline
        type="application/ld+json"
        set:html={JSON.stringify(Array.isArray(jsonLd) ? jsonLd : [jsonLd])}
      />
    )}

    {adsenseClient && (
      <script
        is:inline
        async
        src={`https://pagead2.googlesyndication.com/pagead/js/adsbygoogle.js?client=${adsenseClient}`}
        crossorigin="anonymous"
      />
    )}

    {beaconToken && (
      <script
        is:inline
        defer
        src="https://static.cloudflareinsights.com/beacon.min.js"
        data-cf-beacon={`{"token": "${beaconToken}"}`}
      />
    )}

    {ga4Id && (
      <>
        <script is:inline async src={`https://www.googletagmanager.com/gtag/js?id=${ga4Id}`} />
        <script is:inline define:vars={{ ga4Id }}>
          {`window.dataLayer=window.dataLayer||[];function gtag(){dataLayer.push(arguments)}gtag('js',new Date());gtag('config',ga4Id);`}
        </script>
      </>
    )}
  </head>
  <body>
    <FamilyChrome slug="oriz-pages-ai-blog-app" title="latent" accent="var(--accent)" />
    <a href="#main" class="skip-link">Skip to content</a>
    <Header />
    <div class="notebook">
      {!hideSidebar && (
        <Sidebar width="272px"><CellIndexRail /></Sidebar>
      )}
      <main id="main" class="nb-main"><slot /></main>
    </div>
    <Footer />
    <BottomBar actions={visibleBottomBarActions} />
    <ConsentBanner />

    <script>
      if ('serviceWorker' in navigator && location.hostname !== 'localhost') {
        window.addEventListener('load', () => {
          navigator.serviceWorker.register('/sw.js').catch(() => {})
        })
      }
    </script>
  </body>
</html>

<style>
  /* NOTEBOOK / TWO-PANE shell — left cell-index rail + right content column,
     centered inside the page measure with a vertical cell-gutter rule. */
  .notebook {
    max-width: var(--container-page, 1100px);
    margin-inline: auto;
    display: grid;
    grid-template-columns: 272px minmax(0, 1fr);
    align-items: start;
  }
  .notebook > :global(.site-sidebar) {
    background: transparent;
    border-right: 1px solid var(--rule);
    padding: 1.5rem 1.25rem 1.5rem clamp(0.75rem, 3vw, 1.5rem);
  }
  .nb-main {
    min-width: 0;
    padding-inline: clamp(1.25rem, 3.5vw, 2.5rem);
    padding-block: 0 2rem;
  }
  /* single-column below the tablet breakpoint: rail becomes the mobile drawer
     (Sidebar.astro handles the fixed off-canvas + focus trap), content stacks. */
  @media (max-width: 767px) {
    .notebook { display: block; }
    .nb-main { padding-inline: clamp(1rem, 5vw, 1.5rem); }
  }
</style>
