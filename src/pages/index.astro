---
import SeriesSpine from '~/components/SeriesSpine.astro'
/**
 * /  — latent homepage, NOTEBOOK / TWO-PANE archetype.
 *
 * The left cell-index rail (BaseLayout → CellIndexRail) is the navigation.
 * This right column is the notebook itself: a stack of executed cells.
 *
 *   [0] markdown cell  — the thesis hero (what this notebook is)
 *   In[N] … In[N-k]    — the most recent posts, each an executed code cell
 *                        with an In[n]: prompt gutter + Out: result body
 *   # in-progress      — series as still-running cells (spines)
 *   # namespaces       — categories as a kernel namespace list
 *
 * No card grid, no top-nav masthead. The In[n]:/Out[n]: prompt gutter is the
 * signature; the newest post is the active cell (hot-weight gutter).
 */
import BaseLayout from '~/layouts/BaseLayout.astro'
import {
  getCategoriesWithCounts,
  getPostsInSeries,
  getPublishedPosts,
  getSeriesWithCounts,
  postVertical,
  readingTimeFor,
  slugifyTag,
  verticalFor,
  verticalLabel,
} from '~/lib/blog'
import { SITE_CONFIG } from '~/lib/config'

const allPosts = await getPublishedPosts()
const total = allPosts.length
// Recent posts as executed cells; execution index = recency (newest highest).
const cells = allPosts.slice(0, 8).map((p, i) => ({
  post: p,
  n: total - i,
  active: i === 0,
  vertical: postVertical(p),
}))

const seriesAll = await getSeriesWithCounts()
type InProgress = {
  name: string
  slug: string
  total: number
  published: number
  current: number
  latest: Date
}
const inProgress: InProgress[] = []
for (const { series, count } of seriesAll.slice(0, 4)) {
  const parts = await getPostsInSeries(series)
  const latest = parts.reduce(
    (max, p) => (p.data.pubDate > max ? p.data.pubDate : max),
    parts[0].data.pubDate,
  )
  const explicitMax = parts.reduce((mx, p) => {
    const v = typeof p.data.part === 'number' ? p.data.part : Number(p.data.part)
    return Number.isFinite(v) ? Math.max(mx, v) : mx
  }, 0)
  const seriesTotal = Math.max(count, explicitMax, count + 1)
  inProgress.push({
    name: series,
    slug: slugifyTag(series),
    total: seriesTotal,
    published: count,
    current: count,
    latest,
  })
}
inProgress.sort((a, b) => b.latest.valueOf() - a.latest.valueOf())

const cats = await getCategoriesWithCounts()

// "Days since" for the still-running series cells.
function ago(date: Date): string {
  const days = Math.floor((Date.now() - date.valueOf()) / 86_400_000)
  if (days < 1) return 'today'
  if (days === 1) return '1d ago'
  if (days < 30) return `${days}d ago`
  const months = Math.floor(days / 30)
  if (months === 1) return '1mo ago'
  if (months < 12) return `${months}mo ago`
  const years = Math.floor(days / 365)
  return years === 1 ? '1y ago' : `${years}y ago`
}

const jsonLd = {
  '@context': 'https://schema.org',
  '@type': 'Blog',
  name: SITE_CONFIG.title,
  url: `${SITE_CONFIG.url}/`,
  description: SITE_CONFIG.description,
  author: { '@type': 'Person', name: SITE_CONFIG.author.name, url: SITE_CONFIG.author.url },
}
---

<BaseLayout
  title="latent — a notebook on shipping AI systems"
  description={SITE_CONFIG.description}
  jsonLd={jsonLd}
>
  <div class="nb">
    {/* [0] — the thesis markdown cell */}
    <section class="cell cell--md" aria-labelledby="thesis">
      <span class="cell-gutter mono" aria-hidden="true">[<span class="cg-n">0</span>]</span>
      <div class="cell-body">
        <p class="cell-tag mono">markdown · thesis</p>
        <h1 id="thesis" class="thesis">
          Build AI systems that survive <span class="thesis-hot">production</span>.
        </h1>
        <p class="thesis-sub">
          A running notebook on RAG, tool-using agents, and honest evals — what
          worked, what broke, and the numbers behind both. Every post below is a
          cell, executed in order, newest at the top.
        </p>
        <p class="thesis-run mono">
          <span class="tr-key">runtime</span>
          <span class="tr-val">{total} cells</span>
          <span class="tr-sep" aria-hidden="true">·</span>
          <span class="tr-val">{inProgress.length} still running</span>
          <span class="tr-sep" aria-hidden="true">·</span>
          <span class="tr-val">{cats.length} namespaces</span>
        </p>
      </div>
    </section>

    {/* In[n]: — recent posts as executed cells */}
    <ol class="cell-stack" role="list">
      {cells.map((c) => (
        <li class="cell cell--exec" data-vertical={c.vertical} data-active={c.active ? 'true' : undefined}>
          <span class="cell-gutter mono" aria-hidden="true">In[<span class="cg-n">{c.n}</span>]</span>
          <a class="cell-body cell-link" href={`/blog/${c.post.id}`}>
            <span class="exec-kicker mono">
              <span class="exec-tick" aria-hidden="true"></span>{verticalLabel(c.vertical)}
              {c.active && <span class="exec-flag">active cell</span>}
            </span>
            <h2 class="exec-title">{c.post.data.title}</h2>
            <p class="exec-out">
              <span class="out-prompt mono" aria-hidden="true">Out:</span>
              <span class="out-dek">{c.post.data.description}</span>
            </p>
            <span class="exec-meta mono">
              <time datetime={c.post.data.pubDate.toISOString()}>{c.post.data.pubDate.toISOString().slice(0, 10)}</time>
              <span aria-hidden="true">·</span>
              <span>{c.post.data.readingTime ?? readingTimeFor(c.post)}</span>
            </span>
          </a>
        </li>
      ))}
    </ol>

    <p class="nb-all mono"><a href="/archive/">run all {total} cells in the archive →</a></p>

    {/* # in-progress — still-running series cells */}
    {inProgress.length > 0 && (
      <section class="cell cell--section" aria-labelledby="running">
        <span class="cell-gutter mono" aria-hidden="true">#</span>
        <div class="cell-body">
          <h2 id="running" class="section-h mono">in progress · series still running</h2>
          <ul class="run-list" role="list">
            {inProgress.map((s) => (
              <li class="run-row">
                <a class="run-link" href={`/series/${s.slug}/`}>
                  <span class="run-name">{s.name}</span>
                  <span class="run-spine"><SeriesSpine total={s.total} published={s.published} current={s.current} size="md" /></span>
                  <span class="run-meta mono">part {s.published}/{s.total}</span>
                  <span class="run-ago mono">{ago(s.latest)}</span>
                </a>
              </li>
            ))}
          </ul>
        </div>
      </section>
    )}

    {/* # namespaces — categories */}
    {cats.length > 0 && (
      <section class="cell cell--section" aria-labelledby="ns">
        <span class="cell-gutter mono" aria-hidden="true">#</span>
        <div class="cell-body">
          <h2 id="ns" class="section-h mono">namespaces · by category</h2>
          <p class="ns-row">
            {cats.map((cat, i) => (
              <>
                {i > 0 && <span class="ns-sep" aria-hidden="true">·</span>}
                <a href={`/categories/${slugifyTag(cat.category)}/`} class="ns-link" data-vertical={verticalFor(cat.category)}>
                  <span class="ns-name">{cat.category}</span>
                  <span class="ns-count mono">{cat.count}</span>
                </a>
              </>
            ))}
          </p>
        </div>
      </section>
    )}
  </div>
</BaseLayout>

<style>
  .nb { display: flex; flex-direction: column; padding-block: 1.75rem; }

  .sr-only {
    position: absolute; width: 1px; height: 1px; padding: 0; margin: -1px;
    overflow: hidden; clip: rect(0, 0, 0, 0); white-space: nowrap; border: 0;
  }

  /* ── cell frame: prompt gutter + body ───────────────────────────────── */
  .cell {
    display: grid;
    grid-template-columns: 4.25em minmax(0, 1fr);
    column-gap: 0.75rem;
    padding-block: 1rem;
  }
  .cell-gutter {
    font-size: 11px;
    color: var(--ink-mute);
    letter-spacing: -0.02em;
    text-align: right;
    padding-top: 0.375rem;
    white-space: nowrap;
    user-select: none;
  }
  .cg-n { color: var(--accent); }
  .cell-body { min-width: 0; }

  /* ── [0] thesis markdown cell ───────────────────────────────────────── */
  .cell--md { border-bottom: 2px solid var(--ink); padding-bottom: 1.75rem; }
  .cell-tag {
    font-size: 10px; letter-spacing: 0.2em; text-transform: uppercase;
    color: var(--ink-mute); margin: 0 0 0.75rem;
  }
  .thesis {
    font-family: var(--font-display);
    font-size: clamp(2rem, 6vw, 3.5rem);
    font-weight: 560;
    letter-spacing: -0.03em;
    line-height: 1.04;
    color: var(--ink);
    margin: 0;
    max-width: 16ch;
    font-variation-settings: "opsz" 144, "SOFT" 0, "WONK" 1;
  }
  .thesis-hot { color: var(--hot); position: relative; }
  .thesis-hot::after {
    content: ''; position: absolute; left: 0; right: 0; bottom: 0.04em;
    height: 0.08em; background: var(--hot);
  }
  .thesis-sub {
    font-family: var(--font-serif);
    font-size: clamp(1.0625rem, 2vw, 1.25rem);
    line-height: 1.5; color: var(--ink-mute);
    margin: 1.25rem 0 0; max-width: 54ch;
  }
  .thesis-run {
    display: flex; flex-wrap: wrap; gap: 0.5rem; align-items: baseline;
    margin: 1.25rem 0 0; font-size: 11px; letter-spacing: 0.04em; color: var(--ink-mute);
  }
  .tr-key { text-transform: uppercase; letter-spacing: 0.14em; color: var(--accent); }
  .tr-val { color: var(--ink); }
  .tr-sep { color: var(--rule-strong, var(--rule)); }

  /* ── executed post cells ────────────────────────────────────────────── */
  .cell-stack { list-style: none; margin: 0; padding: 0; }
  .cell--exec { --v: var(--v-personal); border-bottom: 1px solid color-mix(in oklab, var(--rule) 75%, transparent); }
  .cell--exec[data-vertical='dev'] { --v: var(--v-dev); }
  .cell--exec[data-vertical='finance'] { --v: var(--v-finance); }
  .cell--exec[data-vertical='culture'] { --v: var(--v-culture); }
  .cell--exec[data-vertical='health'] { --v: var(--v-health); }
  .cell--exec .cell-gutter { color: var(--v); }
  .cell--exec .cg-n { color: var(--v); }
  .cell--exec[data-active='true'] { background: color-mix(in oklab, var(--hot) 5%, transparent); }
  .cell--exec[data-active='true'] .cell-gutter,
  .cell--exec[data-active='true'] .cg-n { color: var(--hot); }

  .cell-link {
    display: grid; gap: 0.375rem; color: var(--ink); text-decoration: none;
    border-left: 2px solid transparent;
    padding-left: 0.75rem; margin-left: -0.75rem;
    transition: border-color var(--dur-fast) ease;
  }
  .cell-link:hover { border-left-color: var(--v); }
  .cell--exec[data-active='true'] .cell-link { border-left-color: var(--hot); }
  .cell-link:hover .exec-title { color: var(--accent); }

  .exec-kicker {
    display: inline-flex; align-items: center; gap: 0.375rem;
    font-size: 10px; letter-spacing: 0.14em; text-transform: uppercase;
    color: var(--v); font-weight: 500;
  }
  .exec-tick { width: 6px; height: 6px; background: var(--v); flex: 0 0 auto; }
  .exec-flag {
    margin-left: 0.25rem; padding-left: 0.5rem; border-left: 1px solid var(--rule);
    color: var(--hot);
  }
  .exec-title {
    font-family: var(--font-display);
    font-size: clamp(1.25rem, 2.6vw, 1.625rem);
    font-weight: 600; letter-spacing: -0.015em; line-height: 1.18;
    color: var(--ink); margin: 0; max-width: 28ch;
  }
  .exec-out { display: grid; grid-template-columns: 2.75em 1fr; gap: 0.5rem; margin: 0.125rem 0 0; align-items: baseline; }
  .out-prompt { font-size: 11px; color: var(--ink-mute); text-align: right; }
  .out-dek {
    font-family: var(--font-serif); font-size: 15px; line-height: 1.5; color: var(--ink-mute);
    display: -webkit-box; -webkit-box-orient: vertical; -webkit-line-clamp: 2; line-clamp: 2; overflow: hidden;
  }
  .exec-meta { display: inline-flex; gap: 0.5rem; font-size: 11px; letter-spacing: 0.04em; color: var(--ink-mute); margin-top: 0.125rem; }

  @media (max-width: 480px) {
    .exec-out { grid-template-columns: 1fr; }
    .out-prompt { display: none; }
  }

  .nb-all { margin: 1.5rem 0 0; padding-left: 5em; font-size: 12px; }
  .nb-all a { color: var(--ink-mute); text-decoration: none; }
  .nb-all a:hover { color: var(--accent); }

  /* ── section cells (# in-progress / # namespaces) ───────────────────── */
  .cell--section { padding-top: 2rem; }
  .cell--section .cell-gutter { color: var(--accent); font-size: 15px; }
  .section-h {
    font-size: 11px; text-transform: uppercase; letter-spacing: 0.18em;
    color: var(--ink-mute); font-weight: 500; margin: 0 0 1rem;
  }

  .run-list { list-style: none; margin: 0; padding: 0; display: flex; flex-direction: column; gap: 0.25rem; }
  .run-link {
    display: grid; grid-template-columns: minmax(0, 1fr) auto auto auto; gap: 1rem;
    align-items: baseline; color: var(--ink); text-decoration: none; padding-block: 0.5rem;
  }
  .run-link:hover { color: var(--accent); }
  .run-link:hover .run-meta, .run-link:hover .run-ago { color: var(--accent); }
  .run-name {
    font-family: var(--font-display); font-size: 1.0625rem; font-weight: 600;
    letter-spacing: -0.01em; overflow: hidden; text-overflow: ellipsis; white-space: nowrap;
  }
  .run-spine { display: inline-flex; }
  .run-meta, .run-ago { font-family: var(--font-mono); font-size: 11px; letter-spacing: 0.04em; color: var(--ink-mute); }

  @media (max-width: 640px) {
    .run-link {
      grid-template-columns: minmax(0, 1fr) auto;
      grid-template-areas: 'name ago' 'spine meta';
      row-gap: 0.25rem;
    }
    .run-name { grid-area: name; }
    .run-spine { grid-area: spine; }
    .run-meta { grid-area: meta; text-align: right; }
    .run-ago { grid-area: ago; text-align: right; }
  }

  .ns-row { margin: 0; line-height: 2; color: var(--ink); }
  .ns-link { --v: var(--v-personal); color: var(--ink); text-decoration: none; margin-inline: 0.125rem; }
  .ns-link[data-vertical='dev'] { --v: var(--v-dev); }
  .ns-link[data-vertical='finance'] { --v: var(--v-finance); }
  .ns-link[data-vertical='culture'] { --v: var(--v-culture); }
  .ns-link[data-vertical='health'] { --v: var(--v-health); }
  .ns-link:hover .ns-name { color: var(--v); }
  .ns-name { font-family: var(--font-display); font-size: 17px; font-weight: 500; letter-spacing: -0.01em; }
  .ns-count { color: var(--ink-mute); font-family: var(--font-mono); font-size: 11px; margin-left: 0.25rem; }
  .ns-sep { color: var(--rule); margin-inline: 0.5rem; }

  @media (max-width: 767px) {
    .cell { grid-template-columns: 3em minmax(0, 1fr); column-gap: 0.5rem; }
    .nb-all { padding-left: 3.5em; }
  }
</style>
